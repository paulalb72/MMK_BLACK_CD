Options -Indexes

# Zugangsdaten und Hilfsdateien nie ausliefern
<FilesMatch "^(\.env.*|mail\.php)$">
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
Order allow,deny
Deny from all
</IfModule>
</FilesMatch>
DirectoryIndex index.html index.php
ErrorDocument 404 /fehler/index.html
ErrorDocument 403 /fehler/index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# www -> ohne www, http -> https
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Dateiliste der Bilder nicht direkt ausliefern, nur über /bild/?n=
RewriteRule ^bild/img/ - [R=404,L]
</IfModule>

# Alte Leistungsseiten (bis 23.10.2026) auf die neuen umleiten
<IfModule mod_alias.c>
RedirectMatch 301 ^/leistungen/ki-check/?$ /leistungen/prozess-check/
RedirectMatch 301 ^/leistungen/ki-assistenten/?$ /leistungen/wissensassistent/
RedirectMatch 301 ^/leistungen/tools/?$ /leistungen/softwaretools/
RedirectMatch 301 ^/leistungen/(automatisierung|schulung)/?$ /leistungen/
# Branchenseiten entfernt (23.10.2026)
RedirectMatch 301 ^/branchen(/.*)?$ /
# Ablauf-Seite entfernt (23.10.2026)
RedirectMatch 301 ^/ablauf/?$ /#vorgehen
</IfModule>


<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
Header always set Content-Security-Policy "upgrade-insecure-requests"
<FilesMatch "\.(woff2|css)$">
Header set Cache-Control "public, max-age=31536000"
</FilesMatch>
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/xml application/xml
</IfModule>
